# ==============================================================================
# RepurAgent Environment Configuration (.env.example)
# ==============================================================================

# --- Execution Profile --------------------------------------------------------
# Set to 'true' for memory-constrained environments (e.g., 4 GB RAM Windows machines).
# This profile enforces:
# - Native Windows execution (no Docker/WSL2 overhead)
# - Bounded interpreter sessions (cache=4 instead of 32)
# - Reduced UI polling and concurrency limits
# - Remote embeddings for episodic store (no local ONNX weights loaded into RAM)
# - Safe JVM memory bounds (-Xmx256m) if Java is invoked
LOCAL_CONSTRAINED_MODE=true

# --- LLM Provider Configuration (Choose Option A or Option B) ----------------
# OPTION A: Google Gemini API (Recommended for Free Tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-2.5-flash

# OPTION B: OpenAI API
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Model Selection (Optional overrides) -------------------------------------
# If using Gemini, all roles automatically default to gemini-2.5-flash unless overridden:
# PLANNING_MODEL=gemini-2.5-flash
# SUPERVISOR_MODEL=gemini-2.5-flash
# DATA_MODEL=gemini-2.5-flash
# RESEARCH_MODEL=gemini-2.5-flash
# PREDICTION_MODEL=gemini-2.5-flash
# REPORT_MODEL=gemini-2.5-flash

# --- RAG & Embedding Models ---------------------------------------------------
# SOP_EMBEDDING_MODEL=text-embedding-3-large
# EPISODIC_EMBEDDING_MODEL=text-embedding-3-small

# --- Memory & Resource Tuning -------------------------------------------------
# PYTHON_SESSION_CACHE_SIZE=4
# FILE_LIST_REFRESH_INTERVAL_SECONDS=3.0
# CPSIGN_JAVA_MEMORY_FLAGS=-Xmx256m -Xms64m -XX:+UseSerialGC
# CPSIGN_ALLOW_LOCAL_JVM=true
# DEFAULT_USE_EPISODIC_LEARNING=false

# --- LangSmith Tracing (Optional) ---------------------------------------------
# LANGSMITH_TRACING=false
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=repuragent

